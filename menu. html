<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Zesty - قائمة الطعام</title>
  <style>
    body { font-family: system-ui, sans-serif; background-color: #f8f9fa; padding: 15px; margin: 0; }
    .container { max-width: 500px; margin: auto; }
    .header-box { text-align: center; margin-bottom: 20px; border-bottom: 2px solid #e9ecef; padding-bottom: 15px; }
    h1 { color: #28a745; margin: 0; font-size: 2rem; }
    .sub-title { color: #6c757d; font-size: 0.9rem; margin-top: 5px; }
    
    .category-title { background: #28a745; color: white; padding: 10px 15px; border-radius: 8px; margin-top: 25px; margin-bottom: 12px; font-size: 1.2rem; font-weight: bold; }
    .card { background: white; border-radius: 12px; padding: 14px 18px; margin-bottom: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: space-between; border-right: 4px solid #007bff; }
    .item-name { font-size: 1.1rem; font-weight: bold; color: #222; }
    .item-price { font-size: 1.1rem; font-weight: bold; color: #d9534f; background: #fff5f5; padding: 4px 10px; border-radius: 6px; }
  </style>
</head>
<body>

<div class="container">
  <div class="header-box">
    <h1>🍽️ ZESTY MENU</h1>
    <div class="sub-title">أهلاً بكم! نتمنى لكم تجربة ممتازة ✨</div>
  </div>

  <div id="menuContainer">جاري تحميل الأصناف...</div>
</div>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
  import { getFirestore, collection, onSnapshot } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBTEPyT_ylg83IZRiO4sUSWs8LKOt3x11Q",
    authDomain: "zesty-menu-64909.firebaseapp.com",
    projectId: "zesty-menu-64909",
    storageBucket: "zesty-menu-64909.firebasestorage.app",
    messagingSenderId: "213107051074",
    appId: "1:213107051074:web:5e4fb4743206f99823fbdb"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);
  const menuRef = collection(db, "zesty_menu");

  onSnapshot(menuRef, (snapshot) => {
    const menuContainer = document.getElementById("menuContainer");
    menuContainer.innerHTML = "";
    
    if (snapshot.empty) {
      menuContainer.innerHTML = "<p style='text-align:center; color:#777;'>القائمة فارغة حالياً.</p>";
      return;
    }

    const categories = {};
    snapshot.forEach((docSnap) => {
      const data = docSnap.data();
      const cat = data.category || "أخرى";
      if (!categories[cat]) categories[cat] = [];
      categories[cat].push(data);
    });

    for (const [catName, items] of Object.entries(categories)) {
      menuContainer.innerHTML += `<div class="category-title">${catName}</div>`;
      items.forEach((item) => {
        menuContainer.innerHTML += `
          <div class="card">
            <span class="item-name">${item.name}</span>
            <span class="item-price">${item.price} ج.م</span>
          </div>
        `;
      });
    }
  });
</script>

</body>
</html>
